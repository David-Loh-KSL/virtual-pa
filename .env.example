# Copy this file to .env.local for local development
# For Netlify: add these in Site Settings > Environment Variables
# For Coolify: add these in your service environment variables

# Your Notion Integration Token
NOTION_TOKEN=ntn_your_token_here

# Your Notion Database IDs
VITE_TASKS_DB_ID=your_tasks_database_id
VITE_KB_DB_ID=your_kb_database_id

# API base URL
# For Netlify: leave as /api/notion
# For Coolify: leave as /api/notion
# For local dev: leave as /api/notion (proxied by Vite)
VITE_API_BASE=/api/notion
